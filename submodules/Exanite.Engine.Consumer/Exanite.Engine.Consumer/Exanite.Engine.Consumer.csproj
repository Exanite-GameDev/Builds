<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$(Configuration) == Release">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Exanite.Engine" Version="0.0.0-preview-dev-nuget-packing.6703"/>
    <!-- TODO: This shouldn't be necessary and the normal buildsystem package doesn't work -->
    <PackageReference Include="Exanite.Engine.BuildSystem.linux-x64" Version="0.0.0-preview-dev-nuget-packing.6703"/>
  </ItemGroup>
</Project>
